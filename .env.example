# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inventory

# API Configuration
SECRET_KEY=change-me-to-a-random-string
API_PORT=8003
CORS_ORIGINS=http://localhost:3000
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-admin-password

# Web Configuration
WEB_PORT=3000
VITE_API_URL=http://localhost:8003

# Drone service
DRONE_HOST=192.168.1.1
DRONE_RTSP_PORT=7070
DRONE_RTSP_URL=rtsp://192.168.1.1:7070/webcam
# DRONE_CLIENT_PORT_BASE=10000
DRONE_VERBOSE_RTSP=false
DRONE_SPEED=30
DRONE_AXIS_DELTA=90
DRONE_HOVER_THROTTLE=128
DRONE_TRIM_AIL=164
DRONE_TRIM_ELE=128
DRONE_TRIM_RUDD=128
DRONE_SEND_INTERVAL=0.04
DRONE_STREAM_TOKEN_TTL_SECONDS=180

# Vision service
VISION_SERVICE_URL=http://vision:8001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# DB Port (host side)
DB_PORT=5432

# ──────────────────────────────────────
